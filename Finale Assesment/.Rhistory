legend.outside.position = "right",
legend.title.size = 0.9,
legend.text.size = 0.7,
frame = FALSE,
inner.margins = c(0.06, 0.02, 0.05, 0.02),
outer.margins = c(0.01, 0.01, 0.01, 0.01),
bg.color = "white"
) +
tm_add_legend(
type = "line",
labels = "Top 100 MSOAs by fertility",
col = "darkblue",
lwd = 2
) +
tm_credits(
"Index combines housing-cost pressure and the concentration of smaller dwellings at MSOA level (standardised).",
position = c("left", "bottom"),
size = 0.85,
color = "grey40"
)
m_hpi
